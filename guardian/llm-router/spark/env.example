# spark-switch environment file.
# NOTE: install-spark-switch.sh copies this file to ~/spark-switch/env and
# replaces SWITCH_TOKEN with a freshly generated random value, so you normally
# do not need to edit that line. Keep the file mode at 600 (owner only).
#
# Values here can be overridden by process environment variables of the same name.

# Container backend. This env file is for the Docker install; the k3s install
# (install-spark-k8s.sh) sets BACKEND=kubernetes through its ConfigMap.
BACKEND=docker

# Controller HTTP listen address/port (inside the container; the installer
# publishes this port on the host).
SWITCH_HOST=0.0.0.0
SWITCH_PORT=8010

# Shared secret for the Authorization: Bearer header. >= 24 chars.
# Generated by the installer; change-me is only a placeholder.
SWITCH_TOKEN=change-me-to-a-long-random-value

# The one and only container this controller is allowed to touch.
MANAGED_CONTAINER=vllm-coder

# vLLM image used when (re)creating the managed container.
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.02-py3

# 기본 1(오프라인): vLLM 컨테이너에 HF_HUB_OFFLINE·TRANSFORMERS_OFFLINE·TIKTOKEN_ENCODINGS_BASE를
# 주입해 모델을 HF_CACHE_HOST 캐시에서만 읽는다. Spark가 인터넷 없는 망에 있으면 0일 때 vLLM이
# huggingface.co 조회에 실패해 재시작을 반복한다. 새 모델을 내려받을 때만 잠시 0으로 둔다.
VLLM_OFFLINE=1

# How the controller reaches the vLLM HTTP API (from inside its container).
VLLM_URL=http://host.docker.internal:8000

# Host port published for the vLLM container (container port is always 8000).
VLLM_HOST_PORT=8000

# File containing one line: VLLM_API_KEY=...  (mounted read-only at /config/vllm-env)
VLLM_ENV_FILE=/config/vllm-env

# HOST path of the HuggingFace cache, bind-mounted into the vLLM container.
# Must be an absolute host path, e.g. /home/YOUR_USER/.cache/huggingface
HF_CACHE_HOST=/home/YOUR_USER/.cache/huggingface

# Profile definitions (shipped next to this file, copied to ~/spark-switch).
PROFILES_FILE=/app/profiles.json

# Profile served after boot and used as the recovery target. May be "pair"
# when RESIDENT_PROFILES is set (the shipped example does exactly that).
DEFAULT_PROFILE=pair

# Resident pair mode (Docker backend only). Comma list of profiles that
# live side by side: slot i serves RESIDENT_PROFILES[i] as container
# f"{MANAGED_CONTAINER}-{i}" (slot 0 keeps the bare name) on host port
# VLLM_HOST_PORT + i; the container port stays 8000. "pair" (and each
# resident name, and "default" when DEFAULT_PROFILE=pair) loads the whole
# set; any other profile evicts both and the idle auto-return brings the
# pair back. Empty (or unset) = single container, the historical behaviour.
RESIDENT_PROFILES=qwen3-instruct,qwen3-coder

# Before creating slot containers, wait up to this many seconds for the
# unified memory freed by the stopped containers to become visible (vLLM
# sizes its KV cache from the memory free at startup, and both slots must
# be created sequentially). 0 = disabled. 600 is recommended with the pair
# mode: big-profile eviction + reload takes minutes.
MEM_WAIT_TIMEOUT=600

# Safety margin added to the memory wait's "needed" estimate (GiB).
MEM_MARGIN_GB=4.0

# Where the controller reads MemTotal/MemAvailable. Inside the controller
# container /proc/meminfo already shows the host's numbers (containers share
# the host kernel and spark-switch runs without a memory limit).
MEMINFO_PATH=/proc/meminfo

# Auto-return to the default profile after this many idle minutes (0 = never).
IDLE_MINUTES=30
IDLE_POLL_SECONDS=60

# After a successful switch, non-default switch requests are rejected for
# this many seconds (switching back to the default is never blocked).
COOLDOWN_SECONDS=120

# First loads of 60-80 GB models can take 10+ minutes.
READY_TIMEOUT=1800
READY_POLL_SECONDS=5

# Seconds to wait for the old container to stop before killing it.
STOP_TIMEOUT=60

# Docker Engine API socket (mounted from the host).
DOCKER_SOCK=/var/run/docker.sock

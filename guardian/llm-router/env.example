# llm-router environment file. The installer copies this to ~/.config/llm-router/env with mode 600.
# KEY=VALUE lines, '#' comments, optional single/double quotes, optional leading 'export '. No shell
# evaluation. A variable set in the real environment wins over what is written here.

# Where the router itself listens. HOST must be loopback (127.0.0.1, ::1 or localhost); anything else
# is refused at startup.
LLM_ROUTER_HOST=127.0.0.1
LLM_ROUTER_PORT=1240
# 1 turns on uvicorn's per-request access lines (incl. the /health probes); default 0 - the router
# already writes its own line for every proxied request.
ACCESS_LOG=0

# local: LM Studio on this Mac. The fast tier and the fallback for every Spark failure.
LOCAL_URL=http://127.0.0.1:1234
LOCAL_MODEL=google/gemma-4-e4b
LOCAL_TOKEN=lmstudio

# spark: the DGX Spark running vLLM on the LAN. Leave empty (or commented) to disable it; everything
# then goes to local. The Spark's address comes from DHCP, so prefer its mDNS name (<hostname>.local,
# published by avahi on the Spark): it follows address changes by itself. The raw IP
# (curl http://<spark>:8000/v1/models shows what it answers today) also works but may go stale.
#SPARK_URL=http://spark.local:8000
# Several Spark URLs at once (e.g. two vLLM instances :8000 and :8001): comma list. Every URL is
# probed separately and each request goes to the URL that serves the model. When set, SPARK_URLS
# wins over SPARK_URL above (which then only documents the first entry). The bundle installer
# writes SPARK_URLS for the default pair (:8000,:8001) on a fresh router install.
#SPARK_URLS=http://spark.local:8000,http://spark.local:8001
# fill in; this file must be chmod 600
SPARK_API_KEY=

# The order the 'spark-large' alias prefers: the first entry below that the Spark is actually serving
# wins; if none is, its first listed model is used. The Spark serves one model at a time and it
# changes (qwen3-instruct, qwen3-coder, gpt-oss-120b, Qwen3-Next-80B, Qwen3-VL-30B, ...), so the router re-reads
# /v1/models on every health probe and picks the swap up by itself within HEALTH_INTERVAL seconds.
SPARK_PREFER=qwen3-instruct,qwen3-coder

# spark-switch (optional): the controller on the Spark that can replace the served model, plain HTTP
# on the LAN. When set, the router polls its /status every HEALTH_INTERVAL, serves
# GET /v1/spark/status + POST /v1/spark/switch (what the spark-model CLI uses), lists not-yet-loaded
# profiles in /v1/models, and answers a request for a known-but-unloaded profile with a hint
# instead of "unknown model". Leave SPARK_SWITCH_URL empty (or commented) to turn all of that off.
#SPARK_SWITCH_URL=http://spark.local:8010
# The controller bearer token: copy the value from ~/spark-switch/env on the Spark without printing
# it into terminals or logs. This file must stay chmod 600.
SPARK_SWITCH_TOKEN=

# Health probing and limits. HEALTH_FAIL consecutive failed probes mark a backend down, HEALTH_OK
# consecutive good ones bring it back (the very first probe after startup decides immediately).
HEALTH_INTERVAL=10
HEALTH_FAIL=2
HEALTH_OK=2
CONNECT_TIMEOUT=2
HEALTH_TIMEOUT=5
MAX_BODY_MB=32
# Proxy pool: keep max_connections >= expected concurrent streams (align with vLLM max_num_seqs);
# when it is full the router answers 503 overloaded_error instead of failing over. The health
# probe and switch POSTs use their own small pool, so overload is never mistaken for an outage.
UPSTREAM_MAX_CONNECTIONS=256
# How long a request may wait for a free proxy connection before that 503.
UPSTREAM_POOL_TIMEOUT=10
# Connect to upstreams over IPv4 only (1, default) or also IPv6 (0). macOS resolves mDNS .local
# names to an IPv6 link-local address first while vLLM listens on IPv4 only, and httpx has no
# happy-eyeballs, so each NEW named connection would first waste ~1s on the dead IPv6 hop.
# Set 0 only if an upstream URL is IPv6-only (e.g. http://[::1]:1234).
UPSTREAM_IPV4_ONLY=1

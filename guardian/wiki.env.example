# ─────────────────────────────────────────────────────────────────────────
# guardian 통합 번들 — wiki-mcp 설정 (install-wiki.sh 가 <wiki-home>/.env 로 만든다)
#
# 모델은 LM Studio 하나로 통일한다.
#   채팅·raw 변환 : gemma-4-e4b-it-mlx    (gemma-4-E4B MLX 4bit, 번들 포함)
#   임베딩        : text-embedding-bge-m3 (bge-m3 GGUF Q8, 1024차원, 번들 포함 — 한국어 검색용)
# 모델 id 는 LM Studio 가 파일 위치로 정한다. 쓸 수 있는 id: curl -s http://127.0.0.1:1234/v1/models
#
# @@...@@ 자리는 install-wiki.sh 가 채운다. 설치 후 값을 바꾸면
#   launchctl kickstart -k gui/$(id -u)/dev.guardian.wiki-mcpo
#   launchctl kickstart -k gui/$(id -u)/dev.guardian.wiki-watch
# 로 다시 띄운다. 이 파일에는 비밀값(mcpo 키)이 들어 있으므로 권한 600을 유지한다.
# ─────────────────────────────────────────────────────────────────────────

# ═══ 경로 (절대경로 — LaunchAgent 는 셸 프로필을 읽지 않는다) ══════════════
WIKI_VENV=@@VENV@@
WIKI_PATH=@@HOME@@/wiki
WIKI_DATA_DIR=@@HOME@@/wiki-data
WIKI_RAW_DIR=@@HOME@@/raw
WIKI_TEMPLATE_DIR=@@HOME@@/wiki/.templates
WIKI_INGEST_OCR_BIN=@@HOME@@/ocr/vision-ocr

# ═══ 검색 — 하이브리드 (BM25 + bge-m3) ═════════════════════════════════════
EMBEDDING_DISABLED=0
EMBEDDING_PROVIDER=openai
OLLAMA_URL=http://127.0.0.1:1234
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_API_KEY=
# 임베딩 모델을 바꾸면 wiki-mcp 가 다음 기동 때 벡터 저장소를 새로 만들어 전부 다시 임베딩한다.

# ═══ mcpo 브리지 (Open WebUI → wiki-mcp) ═══════════════════════════════════
WIKI_MCPO_HOST=127.0.0.1
WIKI_MCPO_PORT=@@MCPO_PORT@@
WIKI_MCPO_KEY=@@MCPO_KEY@@

# ═══ raw 자동 변환 (watch) — gemma-4-e4b ═══════════════════════════════════
WIKI_INGEST_ENABLED=1
WIKI_INGEST_URL=http://127.0.0.1:1234/v1/chat/completions
WIKI_INGEST_MODEL=gemma-4-e4b-it-mlx
WIKI_INGEST_API_KEY=
# WIKI_INGEST_TEMPLATE=concept
# WIKI_INGEST_TIMEOUT=120
# WIKI_INGEST_MAX_CHARS=6000
# WIKI_INGEST_MAX_NOTES=20
# WIKI_INGEST_MAX_EXTRACT_CHARS=200000
# WIKI_INGEST_XLSX_MAX_ROWS=200
WIKI_INGEST_OCR=1

# ─────────────────────────────────────────────────────────────────────────
# 번들 공용 환경설정 예시
#
# 사용법:
#   cp .env.example .env      # 그리고 필요한 값만 주석 해제/수정
#
# .env 는 ./run-openwebui.sh 와 ./run-wiki-mcp.sh 가 자동으로 읽는다.
# 우선순위: 셸 환경변수 > .env > 스크립트 기본값
#   예) 일회성 오버라이드:  WIKI_INGEST_MODEL=other ./run-wiki-mcp.sh watch
#
# .env 는 gitignore 대상이다 (로컬 설정·비밀값이 커밋되지 않는다).
# ─────────────────────────────────────────────────────────────────────────


# ═══ Open WebUI ═══════════════════════════════════════════════════════════

# 에어갭: 외부 네트워크 호출 차단 (run-openwebui.sh 의 기본값이기도 하다)
HF_HUB_OFFLINE=1
OFFLINE_MODE=1

# 세션 암호화 키 — 미설정 시 자동 생성된다.
# 재기동 간 세션을 유지하려면 고정 키를 지정한다.
# WEBUI_SECRET_KEY=

# 런타임 데이터(DB·업로드) 경로. 기본값은 번들 안 ./data (run-openwebui.sh)
# DATA_DIR=./data

# Open WebUI 포트 (기본 8080). 같은 장비에 다른 Open WebUI가 8080을 쓰면 바꾼다.
# WEBUI_PORT=8081

# 도구 서버 자동 등록 — UI에서 클릭하지 않아도 기동 시 등록된다.
# (JSON 배열 한 줄. mcpo 를 쓰는 경우의 예시)
# TOOL_SERVER_CONNECTIONS=[{"url":"http://localhost:8766","path":"openapi.json","type":"openapi","auth_type":"bearer","key":"<WIKI_MCPO_KEY>"}]


# ═══ Wiki MCP — 경로 ══════════════════════════════════════════════════════

WIKI_PATH=./wiki
WIKI_DATA_DIR=./wiki-data

# 원문 투입 디렉토리 (기본: wiki 상위의 raw)
# WIKI_RAW_DIR=./raw

# 노트 양식 템플릿 (기본: <wiki>/.templates)
# WIKI_TEMPLATE_DIR=./wiki/.templates

# create_note 에서 template 미지정 시 적용할 기본 양식
# WIKI_DEFAULT_TEMPLATE=concept


# ═══ Wiki MCP — 검색 ══════════════════════════════════════════════════════

# BM25-only (임베딩 백엔드 불필요). 의미검색을 쓰려면 0 으로 바꾼다.
EMBEDDING_DISABLED=1

# ── 의미검색(하이브리드) 백엔드 — EMBEDDING_DISABLED=0 일 때만 ──
#
# (A) LM Studio 등 OpenAI 호환 — 실측 검증됨 (nomic = 768차원)
# EMBEDDING_PROVIDER=openai
# OLLAMA_URL=http://localhost:1234
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_API_KEY=
#
# (B) Ollama (bge-m3 = 1024차원)
# EMBEDDING_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3
#
# 주의 1: BM25-only 로 쓰다 임베딩을 켜면 캐시 때문에 벡터가 쌓이지 않는다.
#         rm wiki-data/index_cache.json 후 재인덱싱할 것.
# 주의 2: 모델 차원이 바뀌면 ChromaDB 로드 에러 → rm -rf wiki-data/
#         (노트는 wiki/ 에 있으므로 안전하다)


# ═══ Wiki MCP — mcpo 브리지 ═══════════════════════════════════════════════

WIKI_MCPO_PORT=8766
# 필수 — 기본값 없음. 생성: openssl rand -hex 24
WIKI_MCPO_KEY=


# ═══ Wiki MCP — raw 자동 변환 (watch / ingest_raw) ════════════════════════

# 기본은 off. 켜려면 1 로 바꾸고 아래 모델 설정을 채운다.
# WIKI_INGEST_ENABLED=1

# 생성 LLM (OpenAI 호환 chat completions)
#
# (A) LM Studio
# WIKI_INGEST_URL=http://localhost:1234/v1/chat/completions
# WIKI_INGEST_MODEL=google/gemma-4-e4b
# WIKI_INGEST_API_KEY=
#
# (B) Open WebUI 에 연결된 모델
# WIKI_INGEST_URL=http://localhost:8080/api/chat/completions
# WIKI_INGEST_MODEL=<Open WebUI 에 등록된 모델명>
# WIKI_INGEST_API_KEY=<Open WebUI API 키>

# 생성 노트에 적용할 양식
# WIKI_INGEST_TEMPLATE=concept

# 처리 대상 확장자
# WIKI_INGEST_EXT=.txt,.md,.markdown,.text,.pdf,.docx,.pptx,.xlsx,.html,.htm,.png,.jpg,.jpeg

# LLM 호출 타임아웃(초)
# WIKI_INGEST_TIMEOUT=120

# ── 긴 문서 청킹 (아웃라인 → 노트별 작성) ──
# 이 문자 수를 넘으면 여러 노트로 분할한다. 0 이면 항상 단일 노트.
# WIKI_INGEST_MAX_CHARS=6000
# 문서당 생성 노트 상한
# WIKI_INGEST_MAX_NOTES=20

# ── 문서 추출 (PDF/docx/pptx/xlsx/html) ──
# WIKI_INGEST_MAX_EXTRACT_CHARS=200000
# WIKI_INGEST_XLSX_MAX_ROWS=200

# ── OCR (스캔 PDF·이미지 — Apple Vision, 오프라인) ──
# 기본 on. 바이너리가 없으면 조용히 건너뛴다.
# WIKI_INGEST_OCR=1
# WIKI_INGEST_OCR_BIN=./ocr/vision-ocr
